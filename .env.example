# Settings for the Python jobs (data loading and calculations).
# Copy this file to ".env" and fill in real values. Never commit ".env".

# Environment name: local, ci or production
APP_ENV=local

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Postgres connection string from Supabase.
# Supabase dashboard -> Connect -> "Session pooler" (works on IPv4, needed for GitHub Actions).
# Example: postgresql://postgres.abcdefgh:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# OpenAI key (used from Step 5 onwards)
OPENAI_API_KEY=
